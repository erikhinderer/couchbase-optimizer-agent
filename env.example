# -- Agent memory (Couchbase Enterprise Edition, free developer license) --
MEMORY_CB_USERNAME=Administrator
MEMORY_CB_PASSWORD=change-me-strong-password
MEMORY_CB_BUCKET=agent_memory
MEMORY_CB_SCOPE=agent

# -- Local LLM --
LLM_MODEL=qwen3:8b

# -- Frontend build-time API targets --
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# -- Optional: a cluster can also be registered later via the UI/API instead
# of env vars. These just seed one at first boot for convenience.
SEED_CLUSTER_NAME=
SEED_CLUSTER_KIND=
SEED_CLUSTER_CONNECTION_STRING=
SEED_CLUSTER_USERNAME=
SEED_CLUSTER_PASSWORD=

# -- Capella Management API (only needed if SEED_CLUSTER_KIND=capella and you
# want the agent to read cluster-level metrics via the Capella API in addition
# to per-node stats) --
CAPELLA_API_TOKEN=
CAPELLA_ORG_ID=
