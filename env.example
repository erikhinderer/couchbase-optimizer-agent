# Copy this file to `.env` in the project root before running `docker compose up`:
#   cp env.example .env
#
# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Browser origins allowed to call the backend API (comma-separated). Only needed
# if you're loading the UI from something other than localhost/127.0.0.1 -- set
# this AND VITE_API_BASE_URL/VITE_WS_BASE_URL below to match, then
# `docker compose up --build` (Vite bakes those two in at build time).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://<your-host-or-ip>:5173

# --- Agent memory: Couchbase Enterprise Edition (free for dev/test) ---
MEMORY_CB_USERNAME=Administrator
MEMORY_CB_PASSWORD=change-me-strong-password
MEMORY_CB_BUCKET=agent_memory

# --- Local LLM: Qwen served via Ollama-compatible API ---
QWEN_MODEL_NAME=qwen3:8b

# --- Couchbase Capella Management API (optional -- destination bucket auto-provisioning) ---
# Generate a v4 API token: Capella > Organization Settings > API Keys
CAPELLA_API_TOKEN=
CAPELLA_ORG_ID=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
